# Backend runtime
ENV=dev
PROCESSING_MODE=real
ASR_PROVIDER=groq
EMBED_PROVIDER=hf
LLM_PROVIDER=openai
DSP_ENABLED=false

# Background worker: upload -> media/DSP -> ASR inside the API process
WORKER_ENABLED=true

# Upload and processing limits
MAX_UPLOAD_MB=512
MAX_DURATION_MINUTES=60
PER_USER_DAILY_JOB_LIMIT=10
PER_USER_LECTURE_LIMIT=30



# Optional provider configuration (server-side only)
OPENAI_API_KEY=
CUSTOM_ASR_BASE_URL=
NGROK_AUTHTOKEN=
GROQ_API_KEY=

# DSP
DSP_VERSION=0
DSP_HIGH_PASS_CUTOFF_HZ=80
DSP_SPECTRAL_GATING_ENABLED=false