# Backend runtime
ENV=dev
PROCESSING_MODE=mock
ASR_PROVIDER=none
EMBED_PROVIDER=none
LLM_PROVIDER=none
DSP_ENABLED=false

# Background worker: upload -> media/DSP -> ASR inside the API process
WORKER_ENABLED=true

# Upload and processing limits
MAX_UPLOAD_MB=512
MAX_DURATION_MINUTES=60
PER_USER_DAILY_JOB_LIMIT=5
PER_USER_LECTURE_LIMIT=25

# Firebase (use emulators locally; never commit service-account keys)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Optional provider configuration (server-side only)
OPENAI_API_KEY=
CUSTOM_ASR_BASE_URL=

# DSP
DSP_VERSION=0
DSP_HIGH_PASS_CUTOFF_HZ=80
DSP_SPECTRAL_GATING_ENABLED=false