# Backend runtime
ENV=dev
PROCESSING_MODE=real
ASR_PROVIDER=faster-whisper
EMBED_PROVIDER=hf
LLM_PROVIDER=openai
DSP_ENABLED=false

# Background worker: upload -> media/DSP -> ASR inside the API process
WORKER_ENABLED=true

# Upload and processing limits
MAX_UPLOAD_MB=512
MAX_DURATION_MINUTES=60
PER_USER_DAILY_JOB_LIMIT=5
PER_USER_LECTURE_LIMIT=25

# Optional provider configuration (server‑side only)
OPENAI_API_KEY=
GROQ_API_KEY=
CUSTOM_ASR_BASE_URL=
NGROK_AUTHTOKEN=

# DSP settings (default values from Settings)
DSP_VERSION=0
DSP_HIGH_PASS_CUTOFF_HZ=80
DSP_SPECTRAL_GATING_ENABLED=false
# alias: ENHANCE_AUDIO (keep comments on their own line; compose env_file keeps inline ones as part of the value)
ENHANCE_DEFAULT=false
DSP_RT60=0.5
DSP_FLOOR_DB=-15.0
DSP_REVERB_WEIGHT=0.0
DSP_NOISE_BIAS=1.5

# Whisper model configuration
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
MODEL_CACHE_DIR=/models

# Chunking parameters
CHUNK_SECONDS=30
CHUNK_OVERLAP_SECONDS=5

# Worker concurrency (override via TRANSCRIBE_WORKERS env var)
WORKERS=1

# Job TTL (seconds)
JOB_TTL_SECONDS=86400

# Repository / storage settings (mostly for local dev)
REPOSITORY_BACKEND=auto
LOCAL_STORAGE_ROOT=local_storage
STORAGE_SIGNED_URL_SECRET=local-dev-storage-secret

# Evaluation data root (optional, used by eval scripts)
EVAL_DATA_ROOT=E:\Datasets
